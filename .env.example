# Variable-name template only; export values into the process environment.
# Forge does not load this file automatically. Never put credentials in this file.
OPENAI_API_KEY=
FORGE_BASE_URL=
# Set to chat_completions for providers that do not expose /responses.
FORGE_API_MODE=responses
FORGE_MODEL=gpt-5.6-sol
FORGE_REASONING_EFFORT=medium
