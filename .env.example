# Variable-name template only; export values into the process environment.
# DBAgent does not load this file automatically. Never put credentials in this file.
OPENAI_API_KEY=
DBAGENT_BASE_URL=
# Set to chat_completions for providers that do not expose /responses.
DBAGENT_API_MODE=responses
DBAGENT_MODEL=gpt-5.6-sol
DBAGENT_REASONING_EFFORT=medium
